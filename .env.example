# Можно оставить пустым: приложение запустится в локальном demo-режиме.
# Для внешнего Yandex AI Studio API заполните API-ключ (или IAM-токен) и идентификатор каталога.
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5-lite
# Необязательно: ID сохранённого prompt-шаблона в Yandex AI Studio.
# Без него используются YANDEX_MODEL и встроенная инструкция агента.
YANDEX_PROMPT_ID=
APP_LLM_ACTIVE_PROVIDER=yandex
SERVER_PORT=8080
